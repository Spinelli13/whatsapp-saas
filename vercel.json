{
  "version": 2,
  "buildCommand": "cd src/frontend && npm ci && npm run build",
  "outputDirectory": "src/frontend/dist",
  "env": {
    "VITE_API_URL": "@vite-api-url"
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://your-backend.railway.app/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
